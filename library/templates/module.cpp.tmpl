{{UPPER}}_Configuration* get_configuration(uint8_t i2c_addr, i2c_read_func i2c_read, i2c_write_func i2c_write, sleep_func sleep_ms) {
	{{UPPER}}_Configuration *configuration = new {{UPPER}}_Configuration{
		.platform = {
			.address = i2c_addr,
			.i2c_read = i2c_read,
			.i2c_write = i2c_write,
			.sleep = sleep_ms
		},
	};
	return configuration;
}

void cleanup_configuration({{UPPER}}_Configuration *configuration) {
	delete configuration;
}

#if {{HAS_MOTION}}
{{UPPER}}_Motion_Configuration* get_motion_configuration() {
	{{UPPER}}_Motion_Configuration *configuration = new {{UPPER}}_Motion_Configuration{};
	return configuration;
}

void cleanup_motion_configuration({{UPPER}}_Motion_Configuration *motion_configuration) {
	delete motion_configuration;
}
#endif

